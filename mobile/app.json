{
  "expo": {
    "name": "MedMate",
    "slug": "medmate-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-small.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF6EE"
    },
    "updates": {
      "enabled": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medmate.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "MedMate uses the microphone so you can say 'Yes' to confirm you took your medication.",
        "NSSpeechRecognitionUsageDescription": "MedMate uses speech recognition so you can confirm doses by voice."
      }
    },
    "android": {
      "package": "com.medmate.app",
      "permissions": [
        "RECORD_AUDIO",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "assetBundlePatterns": [
      "assets/**",
      "assets/audio/*"
    ],
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-font",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ae5f9a04-7e2d-4ea3-a1af-2c8b2aee0365"
      }
    },
    "owner": "samanthangong"
  }
}
